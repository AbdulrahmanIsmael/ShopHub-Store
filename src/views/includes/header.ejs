<header class="main-header">
  <!-- Top bar: Logo + User Auth Actions -->
  <div class="main-header__topbar">
    <div class="container main-header__topbar-inner">
      <div class="main-header__logo">
        <a href="/" class="logo-link"> <%- include("./logo.ejs") %> </a>
      </div>
      
      <div class="main-header__auth">
        <% if (!isAuth) { %>
          <a href="/login" class="btn-auth btn-auth--login">
            <svg class="btn-auth__icon" viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
              <path fill-rule="evenodd" d="M3 3a1 1 0 011 1v12a1 1 0 11-2 0V4a1 1 0 011-1zm7.707 3.293a1 1 0 010 1.414L9.414 9H17a1 1 0 110 2H9.414l1.293 1.293a1 1 0 01-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>Login</span>
          </a>
          <a href="/signup" class="btn-auth btn-auth--signup">
            <svg class="btn-auth__icon" viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
              <path d="M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6zM16 7a1 1 0 10-2 0v1h-1a1 1 0 100 2h1v1a1 1 0 102 0v-1h1a1 1 0 100-2h-1V7z" />
            </svg>
            <span>Signup</span>
          </a>
        <% } %>

        <% if (isAuth) { %>
          <div class="main-header__user-badge">
            <span class="user-status-dot"></span>
            <span class="main-header__greeting">Signed In</span>
          </div>
          <form action="/logout" method="post" class="main-header__logout-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn-auth btn-auth--logout">
              <svg class="btn-auth__icon" viewBox="0 0 20 20" fill="currentColor" width="15" height="15">
                <path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd" />
              </svg>
              <span>Logout</span>
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Sub-navbar: Page Navigation Links (Left) + Admin Links (Right) -->
  <nav class="main-header__subnav">
    <div class="container main-header__subnav-inner">
      <!-- Normal customer links on the left -->
      <ul class="main-header__nav-list">
        <li class="main-header__navItems">
          <a href="/" class="main-header__navLink">Home</a>
        </li>
        <li class="main-header__navItems">
          <a href="/products" class="main-header__navLink">Products</a>
        </li>
        <% if(isAuth) { %>
            <li class="main-header__navItems">
              <a href="/cart" class="main-header__navLink">Cart</a>
            </li>
            <li class="main-header__navItems">
              <a href="/orders" class="main-header__navLink">Orders</a>
            </li>
        <% } %>
      </ul>

      <!-- Special Admin links on the right (authenticated only) -->
      <% if (isAuth) { %>
        <ul class="main-header__nav-list main-header__nav-list--admin">
          <li class="main-header__admin-tag">Admin</li>
          <li class="main-header__navItems">
            <a href="/admin/add-product" class="main-header__navLink main-header__navLink--admin">
              <span class="admin-icon">+</span>
              <span>Add Product</span>
            </a>
          </li>
          <li class="main-header__navItems">
            <a href="/admin/products" class="main-header__navLink main-header__navLink--admin">
              <span class="admin-icon">⚙</span>
              <span>Admin Products</span>
            </a>
          </li>
        </ul>
      <% } %>
    </div>
  </nav>
</header>
