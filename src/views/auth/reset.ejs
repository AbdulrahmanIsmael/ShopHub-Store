<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../includes/metadata.ejs") %>
    <link rel="stylesheet" href="/css/auth.css" />
  </head>
  <body>
    <%- include("../includes/header.ejs") %>

    <main class="content-wrapper auth-page-wrapper">
      <div class="auth-container">
        <div class="auth-card">
          <div class="auth-card__header">
            <div class="auth-card__icon-wrapper">
              <svg class="auth-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <h1 class="auth-card__title"><%= title %></h1>
            <p class="auth-card__subtitle">Enter your email to receive a password reset link</p>
          </div>

          <form action="/reset" method="POST" class="auth-form">
            <!-- Error Message -->
            <% if (errorMessage && errorMessage.length > 0) { %>
              <div class="auth-error-alert" role="alert">
                <svg class="auth-error-alert__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span><%= errorMessage[0] %></span>
              </div>
            <% } %>

            <div class="form-group">
              <label for="email" class="form-label form-label-required">Email</label>
              <div class="input-group">
                <span class="input-group-addon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="m22 7-10 7L2 7"></path>
                  </svg>
                </span>
                <input
                  type="email"
                  name="email"
                  id="email"
                  class="form-input"
                  placeholder="you@example.com"
                  required
                  autocomplete="email"
                />
              </div>
              <small class="form-help-text">Enter your registered email address</small>
            </div>

            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="auth-form-actions">
              <button type="submit" class="btn btn-primary auth-submit-btn">
                <span>Reset Password</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>

    <%- include("../includes/footer.ejs") %>
  </body>
</html>
